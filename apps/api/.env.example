# Export these into the API process; Spring does not automatically read this file.
AUTH0_ISSUER_URI=https://suitefolk.us.auth0.com/
AUTH0_AUDIENCE=https://api.suitefolk.com
AUTH0_JWK_SET_URI=https://suitefolk.us.auth0.com/.well-known/jwks.json
SUITEFOLK_DB_PASSWORD=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Defaults to false. Enable only for local PayPal sandbox testing.
PAYPAL_AUTOPAY_ENABLED=false
# Optional overrides; the default URLs target the local web/API apps.
PAYPAL_RETURN_URL=http://localhost:8080/api/v1/rent-schedules/paypal/return
PAYPAL_CANCEL_URL=http://localhost:3000/rent/paypal/return?status=cancelled
APP_BASE_URL=http://localhost:3000
